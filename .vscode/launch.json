{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug groops (with build)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/source/build/groops",
            "args": [
                "${input:groopsConfigFile}"
            ],
            "stopAtEntry": false,
            "justMyCode": false,
            "cwd": "${input:groopsRunDir}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Clear debuginfod URLs",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Pretty print complex values",
                    "text": "-gdb-set print pretty on",
                    "ignoreFailures": true
                },
                {
                    "description": "Show dynamic object types",
                    "text": "-gdb-set print object on",
                    "ignoreFailures": true
                },
                {
                    "description": "Do not truncate container elements",
                    "text": "-gdb-set print elements 0",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake-build-groops-debug"
        },
        {
            "name": "Debug groops (fast, no build)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/source/build/groops",
            "args": [
                "${input:groopsConfigFile}"
            ],
            "stopAtEntry": false,
            "justMyCode": false,
            "cwd": "${input:groopsRunDir}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Clear debuginfod URLs",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Pretty print complex values",
                    "text": "-gdb-set print pretty on",
                    "ignoreFailures": true
                },
                {
                    "description": "Show dynamic object types",
                    "text": "-gdb-set print object on",
                    "ignoreFailures": true
                },
                {
                    "description": "Do not truncate container elements",
                    "text": "-gdb-set print elements 0",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Run groops (with build)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/source/build/groops",
            "args": [
                "${input:groopsConfigFile}"
            ],
            "stopAtEntry": false,
            "cwd": "${input:groopsRunDir}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "noDebug": true,
            "preLaunchTask": "cmake-build-groops-debug"
        },
        {
            "name": "Run groops (fast, no build)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/source/build/groops",
            "args": [
                "${input:groopsConfigFile}"
            ],
            "stopAtEntry": false,
            "cwd": "${input:groopsRunDir}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "noDebug": true
        },
        {
            "name": "Build groops only",
            "type": "cppdbg",
            "request": "launch",
            "program": "/bin/true",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "noDebug": true,
            "preLaunchTask": "cmake-build-groops-debug"
        }
    ],
    "inputs": [
        {
            "id": "groopsConfigFile",
            "type": "promptString",
            "description": "Config XML file (relative to run dir or absolute)",
            "default": "05PlotMap.xml"
        },
        {
            "id": "groopsRunDir",
            "type": "promptString",
            "description": "Run directory (absolute)",
            "default": "/home/hanbing/GROOPS/scenario/LeoKinematicOrbit"
        }
    ]
}
